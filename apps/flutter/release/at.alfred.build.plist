<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Build-Dienst der Alfred-App (siehe release/macos-dienst.sh). Kein RunAtLoad: läuft nur auf launchctl kickstart. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>at.alfred.build</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/dev/alfred-app/flutter/release/macos-dienst.sh"</string>
  </array>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
