# v697 — Alfred Sandbox Image: Node 22 + pnpm + git
# Used by Project-Agent Sandbox + Live-Preview Feature
# v706 — Verwendet existing 'node' user (UID/GID 1000) statt eigenen alfred-User
FROM node:22-alpine

# Tools für dev-server + git operations + dumb-init für proper signal-handling
RUN apk add --no-cache git dumb-init bash curl \
  && corepack enable \
  && corepack prepare pnpm@latest --activate

# pnpm-Store global vorbereiten (kann via bind-mount überschrieben werden)
RUN mkdir -p /pnpm-store /workspace \
  && chown -R node:node /pnpm-store /workspace \
  && pnpm config set store-dir /pnpm-store

# Standard-Workdir, wird via -v bind-mount überschrieben
WORKDIR /workspace

# Sicherheits-Hardening: non-root user (node = UID/GID 1000, schon im base image)
USER node

# Container darf nicht mit pid 1 hängenbleiben → dumb-init übernimmt
ENTRYPOINT ["dumb-init", "--"]

# Default-command wird von docker run überschrieben (sh -c "pnpm install && pnpm dev")
CMD ["sh"]
