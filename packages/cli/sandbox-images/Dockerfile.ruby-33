# v901 — Alfred Sandbox Image: Ruby 3.3 + Bundler (Rails)
# Non-root user UID 1000 (passt zum Worktree-Bind-Mount des Agent-Users).
FROM ruby:3.3-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl bash dumb-init build-essential pkg-config \
      libpq-dev libyaml-dev libffi-dev \
  && rm -rf /var/lib/apt/lists/* \
  && useradd -m -u 1000 -s /bin/bash sandbox \
  && mkdir -p /workspace && chown -R sandbox:sandbox /workspace

WORKDIR /workspace
USER sandbox

ENTRYPOINT ["dumb-init", "--"]
CMD ["bash"]
